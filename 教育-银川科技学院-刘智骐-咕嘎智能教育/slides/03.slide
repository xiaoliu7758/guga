<Slide>
  <Box style={{ width: '100%', height: '100%', background: '#F8FAFC', padding: '60px 60px 60px 60px', flexDirection: 'column' }}>
    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12 }}>
      <Text style={{ fontSize: 16, color: '#2563EB', fontWeight: 'bold' }}>01</Text>
      <Text style={{ fontSize: 32, color: '#0B1E3F', fontWeight: 'bold' }}>作品背景与说明</Text>
    </Box>
    <Box style={{ width: '100%', height: 1, background: '#E2E8F0', marginTop: 14, marginBottom: 28 }} />

    <Box style={{ flexDirection: 'row', gap: 28, flex: 1 }}>
      <Box style={{ flex: 1.2, flexDirection: 'column', gap: 20 }}>
        <Box style={{ background: '#FFFFFF', borderRadius: 12, border: '1px solid #E8EDF5', padding: '24px 26px', flexDirection: 'column', gap: 14 }}>
          <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
            <FAIcon name='lightbulb' style={{ fill: '#F59E0B', width: 26, height: 26 }} />
            <Text style={{ fontSize: 22, color: '#1E293B', fontWeight: 'bold' }}>作品缘起</Text>
          </Box>
          <Text style={{ fontSize: 18, color: '#334155', lineHeight: 1.6 }}>
            传统学习工具「千人一面」，难以感知学习者的真实困惑与掌握程度。我们打造的「咕嘎智能教育」是一只<span style={{ fontWeight: 'bold', color: '#2563EB' }}>会学习、能陪学</span>的 AI 桌宠，让 AI 从「被动问答」走向<span style={{ fontWeight: 'bold' }}>主动理解学习者、动态适配教学</span>。
          </Text>
        </Box>
        <Box style={{ background: '#FFFFFF', borderRadius: 12, border: '1px solid #E8EDF5', padding: '24px 26px', flexDirection: 'column', gap: 14 }}>
          <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
            <FAIcon name='book' style={{ fill: '#2563EB', width: 26, height: 26 }} />
            <Text style={{ fontSize: 22, color: '#1E293B', fontWeight: 'bold' }}>核心命题</Text>
          </Box>
          <Text style={{ fontSize: 18, color: '#334155', lineHeight: 1.6 }}>
            不局限于单一学科，而是「<span style={{ fontWeight: 'bold', color: '#2563EB' }}>学什么、教什么</span>」——通过截图理解、思维导图、自适应出题、间隔重复复习等能力，覆盖从知识点到练习巩固的完整学习闭环。
          </Text>
        </Box>
      </Box>

      <Box style={{ flex: 1, background: '#FFFFFF', borderRadius: 12, border: '1px solid #E8EDF5', padding: '24px 26px', flexDirection: 'column', gap: 14 }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
          <FAIcon name='link' style={{ fill: '#0EA5E9', width: 26, height: 26 }} />
          <Text style={{ fontSize: 22, color: '#1E293B', fontWeight: 'bold' }}>参考来源</Text>
        </Box>
        {[
          ['FSRS 间隔重复算法', 'Anki 同源记忆调度'],
          ['认知科学 · 学习风格', 'VARK 学习偏好理论'],
          ['大语言模型 Agent', '工具调用与多步推理'],
          ['视觉多模态理解', '截图语义提取'],
        ].map((item, idx) => (
          <Box key={idx} style={{ flexDirection: 'row', alignItems: 'center', gap: 12, paddingBottom: 12, borderBottom: '1px solid #F1F5F9' }}>
            <Box style={{ width: 8, height: 8, borderRadius: 4, background: '#0EA5E9' }} />
            <Box style={{ flexDirection: 'column' }}>
              <Text style={{ fontSize: 17, color: '#1E293B', fontWeight: 'bold' }}>{item[0]}</Text>
              <Text style={{ fontSize: 15, color: '#94A3B8', marginTop: 2 }}>{item[1]}</Text>
            </Box>
          </Box>
        ))}
      </Box>
    </Box>
  </Box>
</Slide>
